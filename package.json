    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "nuqs": "^2.9.1",
    "radix-ui": "^1.6.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.14.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "4.8.0",
    "zod": "^4.4.3",
