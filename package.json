    "@langfuse/vercel-ai-sdk": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ai": "^7.0.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.1",
