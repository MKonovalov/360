# Database (Neon Postgres)
DATABASE_URL=postgres://user:pass@host/db
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db

# Clerk (from Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# E2E/Playwright test staff account (provisioned per plan 22-03 Task 3). Leave
# empty here — set the real test account email in .env.local only, never commit it.
E2E_CLERK_USER_EMAIL=

# Arcpedia (optional — read-only knowledge integration, Phase 4)
ARCPEDIA_BASE_URL=https://arcpedia.arclumen.de
ARCPEDIA_ACCESS_CLIENT_ID=xxxxxxxx.access
ARCPEDIA_ACCESS_CLIENT_SECRET=xxxxxxxx

# Apollo.io enrichment (optional, Phase 8 — server-only, never PUBLIC_-prefixed).
# Unset disables the Enrich action; the app never crashes on a missing key.
# Get from Apollo: Settings → Integrations → API Keys.
APOLLO_API_KEY=xxxxxxxx
# Prospeo person enrichment (optional, Phase 8 — server-only). Persona lookup
# routes here because Apollo's people_match scope requires a paid plan.
# Get from Prospeo: https://prospeo.io → API Keys (free trial credits, no card).
PROSPEO_API_KEY=xxxxxxxx
# Independent HMAC key for short-lived, user-bound enrichment review proposals.
ENRICHMENT_REVIEW_SECRET=replace-with-at-least-32-random-characters

# Phase 9 Analyze agent (optional, server-only — never PUBLIC_-prefixed).
# Unset disables the Analyze action ("not configured"); the app never crashes
# on a missing key. Get from:
#   Anthropic: console.anthropic.com → API Keys
#   OpenRouter: openrouter.ai → Keys
#   Firecrawl: firecrawl.dev → API Keys
#   Langfuse:  cloud.langfuse.com → Project Settings → API Keys
#   NousResearch: portal.nousresearch.com → API Keys
#   OpenCode: opencode.ai → Zen settings (one key shared Zen + Go)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxx
NOUSRESEARCH_API_KEY=
OPENCODE_API_KEY=
FIRECRAWL_API_KEY=fc-xxxxxxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_TRACE_BASE_URL=https://cloud.langfuse.com
